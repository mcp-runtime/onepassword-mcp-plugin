[
  {
    "id": "gitlab-1password",
    "resource": "http://localhost:8090/gitlab/mcp",
    "required_scopes": ["gitlab:use"],
    "resource_client": {
      "client_id": "gitlab-1password-plugin",
      "public_key_file": "/etc/mcp-auth/gitlab-plugin.pub.pem",
      "algorithm": "RS256"
    },
    "assertion_ttl_seconds": 60
  }
]
