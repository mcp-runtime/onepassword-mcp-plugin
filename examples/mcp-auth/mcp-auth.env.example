# mcp-auth settings for the 1Password plugin. Inject real secrets from your deployment
# environment; never commit them.
MCP_AUTH_ISSUER=https://auth.example.com
MCP_AUTH_LISTEN_ADDR=:8080
MCP_AUTH_REQUIRE_HTTPS=true
MCP_AUTH_TRUST_PROXY_TLS=true
MCP_AUTH_REGISTRATION_ENABLED=true
MCP_AUTH_STORE=sqlite
MCP_AUTH_DATABASE_URL=/var/lib/mcp-auth/mcp-auth.db
MCP_AUTH_PRIVATE_KEY_FILE=/etc/mcp-auth/signing.pem

# Who the users are: your normal login (SSO). Unrelated to 1Password.
MCP_AUTH_CONNECTORS_FILE=/etc/mcp-auth/connectors.json
MCP_AUTH_CONNECTOR=company-sso
MCP_AUTH_UPSTREAM_CLIENT_SECRET=

# The plugin's public URL(s), exactly as MCP clients use them, with the scope each one needs.
MCP_AUTH_RESOURCES=https://mcp.example.com/mcp-proxy/gitlab/mcp
MCP_AUTH_RESOURCE_SCOPES={"https://mcp.example.com/mcp-proxy/gitlab/mcp":["gitlab:use"]}

# Lets the plugin ask mcp-auth to approve credential access for each request.
MCP_AUTH_EXTERNAL_CREDENTIALS_FILE=/etc/mcp-auth/external-credentials.json
